{
  "apps": [
    {
      "name": "pixel-blog",
      "script": "npm",
      "args": "run start:prod",
      "cwd": "/home/abby/pixel-blog",
      "instances": 1,
      "watch": false,
      "env": {
        "NODE_ENV": "production",
        "PORT": "55679"
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": "55679"
      },
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "error_file": "./logs/pm2-error.log",
      "out_file": "./logs/pm2-out.log",
      "log_file": "./logs/pm2-combined.log",
      "time": true,
      "autorestart": true,
      "exec_mode": "fork"
    }
  ]
}